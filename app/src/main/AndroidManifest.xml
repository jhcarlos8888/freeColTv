<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foco en TV (leanback) pero también funciona en móvil -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".FreeColTvApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FreeColTv"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".ui.home.ChannelListActivity"
            android:exported="true"
            android:theme="@style/Theme.FreeColTv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.movies.MovieListActivity"
            android:theme="@style/Theme.FreeColTv" />


        <activity
            android:name=".ui.player.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="landscape" />

        <!-- Referencia a contenido gratuito legal -->
        <activity
            android:name=".ui.info.PublicDomainInfoActivity"
            android:exported="false"
            android:label="Películas gratuitas" />

        <activity
            android:name=".ui.pluto.PlutoActivity"
            android:theme="@style/Theme.FreeColTv"
            android:label="Pluto TV" />

    </application>

</manifest>
